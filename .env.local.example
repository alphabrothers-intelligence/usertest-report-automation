# Anthropic API 키 (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# 채팅 오케스트레이션에 사용할 모델 (기본값: claude-sonnet-5, PRD 6.1절 권장)
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# 정성 분석 호출 안전장치. 기본값은 타임아웃 90초, 일시 오류 1회 재시도, 기본 분석 동시성 3,
# opt-in 극성 총평 동시성 2다. 크레딧을 충전한 조용한 시간대에 측정한 뒤에만 조정한다.
CLAUDE_TIMEOUT_MS=90000
CLAUDE_MAX_ATTEMPTS=2
PIPELINE_CONCURRENCY=3
POLARITY_SUMMARY_CONCURRENCY=2

# 전체 정성 분석이 시작되기 전, 최악 호출 수보다 이 값이 작으면 API를 한 번도 호출하지 않고 중단한다.
# 기본 SW 앱형은 Stage1 14회 + Stage2 최대 40회 = 최대 54회다. 잔액이 부족하면 이 값을 올리지 말 것.
QUALITATIVE_MAX_CLAUDE_CALLS=20

# 정성 분석 비용 가드. 모든 값은 한 번의 분석에 허용하는 보수적 상한이며, 실제 Anthropic
# 모델 단가가 바뀌면 입력/출력 단가도 함께 갱신한다. 기본값만 올려서 실행을 재개하지 말 것.
QUALITATIVE_MAX_ESTIMATED_USD=2
QUALITATIVE_INPUT_USD_PER_MTOKENS=3
QUALITATIVE_OUTPUT_USD_PER_MTOKENS=15

# 원본 PDF와 생성 PDF의 시각적 차이를 점검하는 OpenAI QA 모델.
# 정성 분석은 계속 Anthropic Claude를 사용하며, 이 키가 없어도 보고서 생성은 정상 동작한다.
OPENAI_API_KEY=
OPENAI_LAYOUT_QA_MODEL=gpt-5.6-terra

# Vercel Blob 클라이언트 업로드용 read-write 토큰
# (Vercel 프로젝트에 Blob 스토어를 연결하면 자동으로 채워짐: `vercel env pull`)
BLOB_READ_WRITE_TOKEN=

# Supabase Postgres 연결 문자열 (Project Settings → Database → Connection string →
# Transaction pooler). 비밀번호에 #, @ 등 URL 예약 문자가 있으면 percent-encoding할 것(# → %23).
DATABASE_URL=
