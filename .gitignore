# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# 리서치용 raw data(응답자 개인정보 포함) — 로컬 테스트 전용, 커밋하지 않음
/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local state
/.claude/

# graphify 스킬 산출물(지식그래프 캐시·시각화) — 실행할 때마다 로컬에 생성되는 임시 파일
/graphify-out/

# 로컬 PDF 시각 검증 산출물
/tmp/pdfs/

# 레이아웃 검사 스크립트가 매번 새로 만드는 미리보기 HTML(check:layout-blocks)
/tmp/*.html

# 담당자 확인용으로 그때그때 만드는 원본 대조 이미지
/tmp/review/

# HWPX 동적 그래프 검증 산출물
/output/hwpx-preview-poc/*동적그래프검증*

# STAGE_MAPPING.xlsx 작업 중 저장한 스냅샷/백업본 — 최종본만 커밋
docs/STAGE_MAPPING.pre-*.xlsx
docs/STAGE_MAPPING.backup-*.xlsx

# Serena 로컬 설정
/.serena/
